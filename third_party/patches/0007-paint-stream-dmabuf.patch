@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: Unlicense OR MIT
+
+// Package stream is the state shared by paint.Stream (producer and layout)
+// and the GPU renderer (consumer). giokit patch.
+package stream
+
+import (
+	"image"
+	"sync"
+	"sync/atomic"
+)
+
+// DMABuf describes a single-plane image in GPU memory (Linux DMA-BUF).
+type DMABuf struct {
+	// ID identifies the buffer across frames: a producer cycling through a
+	// fixed set of buffers reuses IDs, and the renderer reuses its import.
+	// It must change whenever the buffer behind it does.
+	ID            uint64
+	FD            int
+	Offset, Pitch uint32
+	Fourcc        uint32
+	Modifier      uint64
+	Width, Height int
+}
+
+// Frame is one image submitted to a stream: CPU pixels or a DMA-BUF.
+type Frame struct {
+	Img     *image.RGBA
+	DMA     *DMABuf
+	Release func() // called once the stream no longer needs the frame; may be nil
+}
+
+func (f Frame) size() image.Point {
+	if f.DMA != nil {
+		return image.Pt(f.DMA.Width, f.DMA.Height)
+	}
+	if f.Img != nil {
+		return f.Img.Rect.Size()
+	}
+	return image.Point{}
+}
+
+// Import states, reported by the renderer.
+const (
+	ImportUnknown     = iota // no DMA-BUF frame drawn yet
+	ImportSupported          // DMA-BUF frames are drawn without a copy
+	ImportUnsupported        // this renderer cannot import: send CPU frames
+)
+
+// Stream holds the newest frame. The renderer uploads (or imports) it into
+// a texture it keeps per stream, and only when Seq has moved on.
+//
+// Imported frames are sampled for as long as they are on screen, so a
+// renderer holds the frame it has bound: such a frame is released when the
+// last renderer holding it lets go, not when a newer frame replaces it.
+// Several renderers (one per window) may draw the same stream; holds are
+// counted, and each Hold must be balanced by one Unhold of the same
+// sequence number.
+//
+// A frame's Release function runs exactly once, without the stream's lock
+// held, on the goroutine that ends the stream's need for the frame: the
+// producer's in Submit or Close, or a renderer's in Use or Unhold. It must
+// therefore be safe to call from any goroutine and should not block.
+//
+// The zero Stream is empty and ready to use.
+type Stream struct {
+	mu     sync.Mutex
+	cur    Frame
+	seq    uint64
+	size   image.Point
+	held   map[uint64]*heldFrame // frames bound by renderers, by sequence number
+	closed bool
+
+	importState atomic.Int32
+}
+
+// heldFrame is a frame bound by one or more renderers.
+type heldFrame struct {
+	frame   Frame
+	holders int
+}
+
+// Submit makes f the current frame and releases the previous one unless a
+// renderer holds it. It waits for an upload in progress, so a released
+// frame is never mid-copy. Submitting an empty Frame releases the current
+// frame and leaves the stream drawing nothing.
+//
+// After Close, Submit releases f immediately and reports false; otherwise
+// it reports true.
+func (s *Stream) Submit(f Frame) bool {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		release(f)
+		return false
+	}
+	old := s.replace(f)
+	s.mu.Unlock()
+	release(old)
+	return true
+}
+
+// Close empties the stream for good: the current frame is released (once
+// no renderer holds it) and later frames are refused. Frames still held are
+// released when their renderers Unhold them, which happens at the latest
+// when a renderer drops the stream's texture after a frame that does not
+// draw it. Close may be called more than once and from any goroutine.
+func (s *Stream) Close() {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return
+	}
+	s.closed = true
+	old := s.replace(Frame{})
+	s.mu.Unlock()
+	release(old)
+}
+
+// replace makes f the current frame and returns the previous one if it
+// must be released now, or the empty Frame if a renderer holds it. s.mu
+// must be held.
+func (s *Stream) replace(f Frame) Frame {
+	old, oldSeq := s.cur, s.seq
+	s.cur = f
+	s.seq++
+	s.size = f.size()
+	if _, held := s.held[oldSeq]; held {
+		return Frame{}
+	}
+	return old
+}
+
+func release(f Frame) {
+	if f.Release != nil {
+		f.Release()
+	}
+}
+
+// Size is the current frame's size.
+func (s *Stream) Size() image.Point {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.size
+}
+
+// ImportState reports whether the renderer imports DMA-BUF frames.
+func (s *Stream) ImportState() int { return int(s.importState.Load()) }
+
+// SetImportState records the renderer's capability.
+func (s *Stream) SetImportState(v int) { s.importState.Store(int32(v)) }
+
+// Use calls fn with the current frame and its sequence number, holding the
+// stream's lock so the frame cannot be released during fn. Inside fn, the
+// renderer may Hold the current frame and Unhold one it held before. Frames
+// whose last hold ends in fn are released after the lock is dropped.
+func (s *Stream) Use(fn func(u *Use)) {
+	s.mu.Lock()
+	u := Use{s: s, Frame: s.cur, Seq: s.seq}
+	fn(&u)
+	s.mu.Unlock()
+	for _, f := range u.release {
+		release(f)
+	}
+}
+
+// Use is the renderer's view of the stream during Stream.Use. It is valid
+// only inside the function passed to Use.
+type Use struct {
+	Frame   Frame
+	Seq     uint64
+	s       *Stream
+	release []Frame
+}
+
+// Hold keeps the current frame from being released until a matching
+// Unhold. Each renderer holds a given frame at most once.
+func (u *Use) Hold() {
+	if u.s.held == nil {
+		u.s.held = make(map[uint64]*heldFrame)
+	}
+	h := u.s.held[u.Seq]
+	if h == nil {
+		h = &heldFrame{frame: u.Frame}
+		u.s.held[u.Seq] = h
+	}
+	h.holders++
+}
+
+// Unhold ends one hold of the frame with sequence number seq. When its last
+// hold ends, the frame is released (after Use returns) unless it is still
+// the current frame. Unholding a frame that is not held does nothing.
+func (u *Use) Unhold(seq uint64) {
+	h, ok := u.s.held[seq]
+	if !ok {
+		return
+	}
+	h.holders--
+	if h.holders > 0 {
+		return
+	}
+	delete(u.s.held, seq)
+	if seq != u.s.seq {
+		u.release = append(u.release, h.frame)
+	}
+}
+
+// Unhold is Use.Unhold outside a Use: for a renderer dropping its texture.
+func (s *Stream) Unhold(seq uint64) {
+	s.Use(func(u *Use) { u.Unhold(seq) })
+}
--- a/internal/stream/stream_test.go
+++ b/internal/stream/stream_test.go
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: Unlicense OR MIT
+
+package stream
+
+import (
+	"image"
+	"testing"
+)
+
+// counted returns a frame whose Release increments *n.
+func counted(n *int) Frame {
+	return Frame{Img: image.NewRGBA(image.Rect(0, 0, 2, 1)), Release: func() { *n++ }}
+}
+
+// hold holds the current frame of s and returns its sequence number.
+func hold(s *Stream) uint64 {
+	var seq uint64
+	s.Use(func(u *Use) {
+		seq = u.Seq
+		u.Hold()
+	})
+	return seq
+}
+
+func TestReplaceReleases(t *testing.T) {
+	var s Stream
+	released := 0
+	s.Submit(counted(&released))
+	if released != 0 {
+		t.Fatalf("current frame released: %d", released)
+	}
+	s.Submit(Frame{})
+	if released != 1 {
+		t.Fatalf("replaced frame released %d times, want 1", released)
+	}
+	if got := s.Size(); got != (image.Point{}) {
+		t.Errorf("empty frame size: %v", got)
+	}
+}
+
+func TestHoldDefersRelease(t *testing.T) {
+	var s Stream
+	released := 0
+	s.Submit(counted(&released))
+	seq := hold(&s)
+	s.Submit(Frame{})
+	if released != 0 {
+		t.Fatalf("held frame released on replace: %d", released)
+	}
+	s.Unhold(seq)
+	if released != 1 {
+		t.Fatalf("held frame released %d times after Unhold, want 1", released)
+	}
+	s.Unhold(seq)
+	if released != 1 {
+		t.Fatalf("second Unhold released again: %d", released)
+	}
+}
+
+func TestUnholdCurrentKeepsFrame(t *testing.T) {
+	var s Stream
+	released := 0
+	s.Submit(counted(&released))
+	seq := hold(&s)
+	s.Unhold(seq)
+	if released != 0 {
+		t.Fatalf("current frame released on Unhold: %d", released)
+	}
+	s.Submit(Frame{})
+	if released != 1 {
+		t.Fatalf("frame released %d times after replace, want 1", released)
+	}
+}
+
+// Two renderers (windows) bind the same frame: it stays alive until both
+// let go.
+func TestTwoHolders(t *testing.T) {
+	var s Stream
+	released := 0
+	s.Submit(counted(&released))
+	first := hold(&s)
+	second := hold(&s)
+	s.Submit(Frame{})
+	s.Unhold(first)
+	if released != 0 {
+		t.Fatalf("frame released with second holder still active: released=%d", released)
+	}
+	s.Unhold(second)
+	if released != 1 {
+		t.Fatalf("frame released %d times after both Unholds, want 1", released)
+	}
+}
+
+func TestReleaseOutsideLock(t *testing.T) {
+	var s Stream
+	// A Release that re-enters the stream deadlocks if it runs under the lock.
+	s.Submit(Frame{Release: func() { s.Size() }})
+	seq := hold(&s)
+	s.Submit(Frame{Release: func() { s.Size() }})
+	s.Unhold(seq)
+	s.Close()
+}
+
+func TestClose(t *testing.T) {
+	var s Stream
+	released := 0
+	s.Submit(counted(&released))
+	s.Close()
+	if released != 1 {
+		t.Fatalf("Close released current frame %d times, want 1", released)
+	}
+	if got := s.Size(); got != (image.Point{}) {
+		t.Errorf("size after Close: %v", got)
+	}
+	late := 0
+	if s.Submit(counted(&late)) {
+		t.Error("Submit after Close accepted the frame")
+	}
+	if late != 1 {
+		t.Errorf("frame submitted after Close released %d times, want 1", late)
+	}
+	s.Use(func(u *Use) {
+		if u.Frame.Img != nil || u.Frame.DMA != nil {
+			t.Error("closed stream has a current frame")
+		}
+	})
+	s.Close()
+	if released != 1 || late != 1 {
+		t.Errorf("second Close released again: %d, %d", released, late)
+	}
+}
+
+func TestCloseWhileHeld(t *testing.T) {
+	var s Stream
+	released := 0
+	s.Submit(counted(&released))
+	seq := hold(&s)
+	s.Close()
+	if released != 0 {
+		t.Fatalf("held frame released on Close: %d", released)
+	}
+	s.Unhold(seq)
+	if released != 1 {
+		t.Fatalf("held frame released %d times after Unhold, want 1", released)
+	}
+}
--- a/op/paint/stream.go
+++ b/op/paint/stream.go
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: Unlicense OR MIT
+
+package paint
+
+import (
+	"image"
+
+	"gioui.org/internal/ops"
+	"gioui.org/internal/stream"
+	"gioui.org/op"
+)
+
+// Stream is an image whose contents change over time: video, a camera, a
+// remote screen. A producer on any goroutine submits frames; the renderer
+// keeps one texture per stream and uploads only frames it has not seen.
+// Unlike creating an ImageOp per frame, nothing is reallocated and no
+// mipmaps are built. giokit patch.
+//
+// Frames are latest-wins: a frame submitted before the previous one was
+// drawn replaces it, so a slow UI drops frames instead of adding latency.
+// Any number of windows may draw the same stream.
+//
+// A producer that is done calls Close, which releases the current frame
+// and refuses later ones. Submitting an empty StreamFrame also releases the
+// current frame but leaves the stream open.
+type Stream struct {
+	// Filter is the scaling filter, as for ImageOp.
+	Filter ImageFilter
+	// OnFrame, if set, is called on the submitting goroutine after each
+	// Submit. Use it to invalidate the window. Set it before the first Submit.
+	OnFrame func()
+
+	s     stream.Stream
+	shape *image.RGBA // size-only placeholder carried by the op
+}
+
+// StreamFrame is one frame: RGBA pixels (alpha is respected) or a DMA-BUF,
+// and a release function called once the stream has finished with it, for
+// pooling. The stream owns the frame's pixels or buffer from Submit until
+// Release; the producer must not modify or reuse them before then.
+//
+// Release runs exactly once per submitted frame. An Image frame is released
+// when a newer frame replaces it or the stream is closed; the renderer
+// copies it under the stream's lock, so replacement waits for the copy. A
+// DMA-BUF frame is sampled in place for as long as it is on screen, so it
+// is released only when every window drawing it has moved to a newer frame
+// or stopped drawing the stream. Release may therefore run on the
+// goroutine calling Submit or Close, or on a window's rendering goroutine.
+// It must be safe for concurrent use with the producer and should not
+// block; it is never called with the stream's lock held.
+type StreamFrame struct {
+	Image   *image.RGBA
+	DMABuf  *DMABuf
+	Release func()
+}
+
+// DMABuf describes a single-plane RGBA image in GPU memory (Linux), such as
+// a hardware video decoder's output. Renderers that can import it draw it
+// with no copy; check Stream.ImportState and send Image frames instead when
+// it reports ImportUnsupported. giokit patch.
+type DMABuf struct {
+	// ID names the buffer across frames. Reuse it when a producer cycles
+	// through a fixed set of buffers (the renderer keeps its import), and
+	// never reuse it for a different buffer.
+	ID            uint64
+	FD            int
+	Offset, Pitch uint32
+	Fourcc        uint32 // DRM fourcc, e.g. ABGR8888 for R,G,B,A bytes
+	Modifier      uint64 // DRM format modifier; 0x00ffffffffffffff for none
+	Width, Height int
+}
+
+// ImportState says whether the renderer draws DMA-BUF frames.
+type ImportState int
+
+const (
+	ImportUnknown     ImportState = iota // no DMA-BUF frame drawn yet
+	ImportSupported                      // drawn in place, no copy
+	ImportUnsupported                    // send Image frames instead
+)
+
+// NewStream returns an empty stream. It draws nothing until the first Submit.
+func NewStream() *Stream { return new(Stream) }
+
+// Submit replaces the current frame. It is safe to call from any goroutine.
+// After Close, Submit releases f at once and does not call OnFrame.
+func (s *Stream) Submit(f StreamFrame) {
+	var d *stream.DMABuf
+	if b := f.DMABuf; b != nil {
+		d = &stream.DMABuf{ID: b.ID, FD: b.FD, Offset: b.Offset, Pitch: b.Pitch, Fourcc: b.Fourcc,
+			Modifier: b.Modifier, Width: b.Width, Height: b.Height}
+	}
+	if !s.s.Submit(stream.Frame{Img: f.Image, DMA: d, Release: f.Release}) {
+		return
+	}
+	if s.OnFrame != nil {
+		s.OnFrame()
+	}
+}
+
+// Close ends the stream: the current frame is released, once no window
+// holds it, and later frames are released as soon as they are submitted.
+// The stream draws nothing afterwards. A window still holding a DMA-BUF
+// frame releases it when it next renders without drawing the stream. Close
+// is safe to call from any goroutine and more than once; it does not call
+// OnFrame, so invalidate the window if the stream is on screen.
+func (s *Stream) Close() { s.s.Close() }
+
+// ImportState reports whether the renderer drawing this stream imports
+// DMA-BUF frames. It stays ImportUnknown until a DMA-BUF frame is drawn.
+func (s *Stream) ImportState() ImportState { return ImportState(s.s.ImportState()) }
+
+// Size is the current frame's size, zero before the first frame.
+func (s *Stream) Size() image.Point { return s.s.Size() }
+
+// Add sets the brush to the stream's current frame, like ImageOp.Add. Follow
+// it with a PaintOp. The image covers (0,0)-Size().
+func (s *Stream) Add(o *op.Ops) {
+	sz := s.s.Size()
+	if sz.X <= 0 || sz.Y <= 0 {
+		return
+	}
+	if s.shape == nil || s.shape.Rect.Size() != sz {
+		s.shape = &image.RGBA{Rect: image.Rectangle{Max: sz}}
+	}
+	data := ops.Write2(&o.Internal, ops.TypeImageLen, s.shape, &s.s)
+	data[0] = byte(ops.TypeImage)
+	data[1] = byte(s.Filter)
+}

--- a/app/giokit_scroll.go
+++ b/app/giokit_scroll.go
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: Unlicense OR MIT
+
+package app
+
+import (
+	"fmt"
+	"image"
+	"math"
+	"os"
+	"strconv"
+	"sync/atomic"
+
+	"gioui.org/f32"
+)
+
+// wheelScale converts one Wayland pointer frame's axis distance to Gio scroll
+// pixels. A classic wheel reports one axis event of ~10-15 units per click,
+// where ~100px suits, so a frame carrying a discrete step is scaled by 10.
+//
+// giokit patch: a high-resolution wheel sends an axis event every 1/8 click
+// (~1.9 units) and the discrete step only with the last one. Upstream scaled
+// that last event too, so it scrolled 10× its neighbours: a ~17px skip once
+// per click. Scale only frames that carry about a whole click per step;
+// high-res sub-steps stay even. A wheel source gives those small steps a
+// modest speed boost without changing touchpad motion.
+func wheelScale(dist f32.Point, steps image.Point, wheel bool) f32.Point {
+	const discreteScale = 10
+	dist.X = scaleAxis(dist.X, steps.X, discreteScale, wheel)
+	dist.Y = scaleAxis(dist.Y, steps.Y, discreteScale, wheel)
+	return dist
+}
+
+func scaleAxis(d float32, steps int, scale float32, wheel bool) float32 {
+	if steps == 0 {
+		if wheel && !GiokitUpstreamWheel.Load() {
+			return d * GiokitWheelMiniStepScale()
+		}
+		return d
+	}
+	// A whole click is ~10-15 units; a high-res sub-step is ~1.9. Anything
+	// under 5 per step is a sub-step.
+	perStep := abs(d) / float32(max(steps, -steps))
+	if perStep < 5 && !GiokitUpstreamWheel.Load() {
+		if wheel {
+			return d * GiokitWheelMiniStepScale()
+		}
+		return d
+	}
+	return d * scale
+}
+
+func abs(v float32) float32 {
+	if v < 0 {
+		return -v
+	}
+	return v
+}
+
+// GiokitUpstreamWheel restores upstream's wheel scaling (scale every frame
+// with a discrete step) when set: for A/B testing the patch in one build
+// (examples/scrolltest, key U). It is process-wide, applies to every
+// window, and may be changed at any time from any goroutine; each Wayland
+// scroll frame reads it when the frame is flushed.
+var GiokitUpstreamWheel atomic.Bool
+
+const defaultWheelMiniStepScale = 1.2
+
+var wheelMiniStepScale = func() *atomic.Uint32 {
+	scale := float32(defaultWheelMiniStepScale)
+	if value, ok := os.LookupEnv("GIOKIT_WHEEL_MINI_STEP_SCALE"); ok {
+		if parsed, err := parseWheelMiniStepScale(value); err == nil {
+			scale = parsed
+		}
+	}
+	v := new(atomic.Uint32)
+	v.Store(math.Float32bits(scale))
+	return v
+}()
+
+// GiokitWheelMiniStepScale returns the multiplier for high-resolution Wayland
+// wheel sub-steps. The setting is process-wide and applies to every window.
+// It defaults to 1.2; the GIOKIT_WHEEL_MINI_STEP_SCALE environment variable,
+// read once when the package is initialized, overrides the default (an
+// invalid value is ignored), and SetGiokitWheelMiniStepScale overrides both.
+func GiokitWheelMiniStepScale() float32 {
+	return math.Float32frombits(wheelMiniStepScale.Load())
+}
+
+// SetGiokitWheelMiniStepScale changes the multiplier for every window. It is
+// safe to call at any time from any goroutine and takes effect from the next
+// scroll frame. It affects Wayland wheel input only; classic wheel clicks and
+// touchpads are unchanged. A scale that is not finite and positive is
+// rejected with an error and leaves the setting as it was.
+func SetGiokitWheelMiniStepScale(scale float32) error {
+	if err := validateWheelMiniStepScale(scale); err != nil {
+		return err
+	}
+	wheelMiniStepScale.Store(math.Float32bits(scale))
+	return nil
+}
+
+func parseWheelMiniStepScale(value string) (float32, error) {
+	v, err := strconv.ParseFloat(value, 32)
+	if err != nil {
+		return 0, fmt.Errorf("invalid wheel mini-step scale %q: %w", value, err)
+	}
+	scale := float32(v)
+	return scale, validateWheelMiniStepScale(scale)
+}
+
+func validateWheelMiniStepScale(scale float32) error {
+	if scale <= 0 || math.IsNaN(float64(scale)) || math.IsInf(float64(scale), 0) {
+		return fmt.Errorf("wheel mini-step scale must be finite and greater than zero")
+	}
+	return nil
+}
--- a/app/giokit_scroll_test.go
+++ b/app/giokit_scroll_test.go
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Unlicense OR MIT
+
+package app
+
+import (
+	"image"
+	"math"
+	"testing"
+
+	"gioui.org/f32"
+)
+
+// A high-resolution wheel click: 8 axis frames of 1.875, discrete on the last.
+// Every frame scrolls 20% more than raw, including the last one (upstream
+// scaled only the last one ×10).
+func TestWheelScaleHighResEven(t *testing.T) {
+	previous := GiokitWheelMiniStepScale()
+	t.Cleanup(func() { _ = SetGiokitWheelMiniStepScale(previous) })
+	if err := SetGiokitWheelMiniStepScale(defaultWheelMiniStepScale); err != nil {
+		t.Fatal(err)
+	}
+	for i := range 8 {
+		steps := image.Point{}
+		if i == 7 {
+			steps.Y = 1
+		}
+		for _, sign := range []float32{1, -1} {
+			if v := wheelScale(f32.Pt(0, sign*1.875), steps.Mul(int(sign)), true).Y; v != sign*2.25 {
+				t.Fatalf("sub-step %d (sign %v): %v, want %v", i, sign, v, sign*2.25)
+			}
+		}
+	}
+	// Classic wheel: one event of 15 per click, scaled to a ~150px step.
+	if v := wheelScale(f32.Pt(0, -15), image.Pt(0, -1), true).Y; v != -150 {
+		t.Errorf("classic click: %v, want -150", v)
+	}
+	// Touchpad: no discrete steps, untouched.
+	if v := wheelScale(f32.Pt(0, 3), image.Point{}, false).Y; v != 3 {
+		t.Errorf("touchpad: %v, want 3", v)
+	}
+	if v := wheelScale(f32.Pt(0, 3), image.Point{}, true).Y; math.Abs(float64(v)-3.6) > 1e-5 {
+		t.Errorf("wheel mini-step without discrete marker: %v, want 3.6", v)
+	}
+	// Upstream mode reproduces the bug, for the A/B bench.
+	GiokitUpstreamWheel.Store(true)
+	defer GiokitUpstreamWheel.Store(false)
+	if v := wheelScale(f32.Pt(0, 1.875), image.Pt(0, 1), true).Y; v != 18.75 {
+		t.Errorf("upstream mode: %v, want 18.75", v)
+	}
+	if v := wheelScale(f32.Pt(0, 1.875), image.Point{}, true).Y; v != 1.875 {
+		t.Errorf("upstream unmarked sub-step: %v, want 1.875", v)
+	}
+}
+
+func TestWheelMiniStepScaleConfiguration(t *testing.T) {
+	previous := GiokitWheelMiniStepScale()
+	t.Cleanup(func() { _ = SetGiokitWheelMiniStepScale(previous) })
+	if err := SetGiokitWheelMiniStepScale(1.5); err != nil {
+		t.Fatal(err)
+	}
+	if got := GiokitWheelMiniStepScale(); got != 1.5 {
+		t.Fatalf("configured scale: got %v, want 1.5", got)
+	}
+	if got := wheelScale(f32.Pt(0, 2), image.Point{}, true).Y; got != 3 {
+		t.Errorf("wheel sub-step: got %v, want 3", got)
+	}
+	if got := wheelScale(f32.Pt(0, 2), image.Point{}, false).Y; got != 2 {
+		t.Errorf("touchpad: got %v, want 2", got)
+	}
+	if got := wheelScale(f32.Pt(0, 15), image.Pt(0, 1), true).Y; got != 150 {
+		t.Errorf("classic wheel: got %v, want 150", got)
+	}
+	for _, invalid := range []float32{0, -1, float32(math.NaN()), float32(math.Inf(1))} {
+		if err := SetGiokitWheelMiniStepScale(invalid); err == nil {
+			t.Errorf("accepted invalid scale %v", invalid)
+		}
+		if got := GiokitWheelMiniStepScale(); got != 1.5 {
+			t.Errorf("invalid scale changed setting to %v", got)
+		}
+	}
+	for _, value := range []string{"0.8", "2"} {
+		if _, err := parseWheelMiniStepScale(value); err != nil {
+			t.Errorf("rejected environment value %q: %v", value, err)
+		}
+	}
+	for _, value := range []string{"", "0", "NaN", "-1", "nonsense"} {
+		if _, err := parseWheelMiniStepScale(value); err == nil {
+			t.Errorf("accepted invalid environment value %q", value)
+		}
+	}
+}
--- a/app/giokit_trace.go
+++ b/app/giokit_trace.go
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: Unlicense OR MIT
+
+package app
+
+// GiokitTrace receives low-level window events for debugging when set.
+// Keys and values alternate in kv. giokit patch.
+//
+// It is process-wide and read without synchronization from every window's
+// goroutines, possibly concurrently, so the function must be safe for
+// concurrent use. Set it once at program start, before the first window is
+// created, and do not change it afterwards: a later assignment is a data
+// race. giokit's kit/forktrace package sets it from its init function when
+// GIOKIT_TRACE is enabled, which Go's initialization order places before
+// main runs.
+var GiokitTrace func(kind string, kv ...any)
+
+func gtrace(kind string, kv ...any) {
+	if f := GiokitTrace; f != nil {
+		f(kind, kv...)
+	}
+}
